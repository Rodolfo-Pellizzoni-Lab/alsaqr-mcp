{
 "hardware": "~/he-soc/hardware",
 "software": "~/he-soc/software",
 "work": "~/he-soc/hardware/xsim/work",
 "state": "~/he-soc/hardware/xsim/work/mcp",
 "tb_file": "~/he-soc/hardware/tb/ariane_tb.sv",
 "dpi_dir": "~/he-soc/hardware/xsim/work",
 "uint_compat": "~/he-soc/hardware/xsim/sw/uint_compat.h",
 "riscv_gcc_bin": "~/.cache/he-soc-simexp/gcc2/riscv/bin",
 "readelf": "~/.cache/he-soc-simexp/gcc2/riscv/bin/riscv64-unknown-elf-readelf",
 "vivado_settings": "/tools/Xilinx/Vivado/2024.2/settings64.sh",
 "tb_defines": [
  "XSIM_NO_AXI_DRV",
  "XSIM_L2_PRELOAD",
  "XSIM_L3_FLOW"
 ],
 "xelab_generics": {
  "USE_S25FS256S_MODEL": 0,
  "USE_24FC1025_MODEL": 0,
  "USE_SDIO": 0,
  "USE_SDVT_CPI": 0,
  "USE_CAN": 0,
  "USE_ETHERNET": 0,
  "USE_USART": 0
 },
 "plusargs": {
  "CORE_ID": "0",
  "CL_STRING": "none",
  "OT_SRAM": "none",
  "OT_FLASH": "none",
  "OT_CLUSTER": "none",
  "BOOTMODE": "0",
  "UVM_NO_RELNOTES": "",
  "MAX_CYCLES": "10000000",
  "UVM_TESTNAME": "core_test"
 },
 "memory_map": {
  "sram": {
   "base": "0x1C000000",
   "size": "0x8000"
  },
  "dram": {
   "base": "0x80000000",
   "size": "0x20000000"
  },
  "entry": "0x80000000"
 },
 "stall_idle_s": 180,
 "default_timeout_s": 7200,
 "toolchain_bundle": "~/alsaqr-software",
 "fpga": {
  "dir": "~/he-soc/hardware/fpga",
  "env": {
   "VIVADO_VERSION": "vitis-2020.2",
   "BOARD": "vcu118",
   "XILINX_PART": "xcvu9p-flga2104-2L-e",
   "XILINX_BOARD": "xilinx.com:vcu118:part0:2.0",
   "AXI_ID_DDR_WIDTH": "9",
   "MAIN_MEM": "DDR4",
   "SIMPLE_PAD": "SPI-I2C-UART-SDIO",
   "USE_OT": "0",
   "ETH2FMC_NO_PAD": "0",
   "NUM_CORES": "4",
   "XILINX_ETH": "1"
  },
  "path_prepend": "~/.cache/he-soc-simexp/fpga_bin",
  "soc_mhz": 50,
  "directives": {
   "opt": "Default",
   "place": "AltSpreadLogic_high",
   "route": "Default"
  },
  "builds": "~/he-soc/hardware/xsim/work/mcp/fpga",
  "bender_make": "simple-padframe=1 exclude-cluster=1 exclude-rot=1 quad-core=1 exclude-ethernet=1 xilinx-ethernet=1 scripts-bender-fpga-ddr"
 },
 "board": {
  "bundle": "~/alsaqr-software",
  "uart": "/dev/ttyUSB3",
  "baud": 38400,
  "openocd_cores": 2,
  "ddr_wait_s": 30,
  "run_ms": 8000,
  "linux": {
   "payload": "~/alsaqr-software/linux/prebuilt/fw_payload.elf",
   "dtb": "~/alsaqr-software/linux/prebuilt/alsaqr.dtb",
   "dtb_addr": "0x81800000",
   "num_harts": 4,
   "console_capture_s": 7200,
   "netboot": {
    "elf": "~/he-soc/software/netboot/netboot.riscv",
    "payload": "~/alsaqr-software/linux/cva6-sdk/install64/fw_payload.elf",
    "dtb": "~/alsaqr-software/linux/cva6-sdk/install64/alsaqr-socket.dtb",
    "host_ip": "10.42.0.1",
    "port": 6969
   }
  }
 }
}